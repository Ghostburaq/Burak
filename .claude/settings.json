{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "command -v headroom >/dev/null 2>&1 && headroom init hook ensure >/dev/null 2>&1 || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "command -v headroom >/dev/null 2>&1 && headroom init hook ensure >/dev/null 2>&1 || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
