#!/usr/bin/env bash
# Sprache erkennen (Whisper, lokal auf CPU), SRT erzeugen und optional ins Video brennen
# Nutzung: untertitel video.mp4 [modell=small] [einbrennen=ja|nein] [sprache=de]
set -euo pipefail
in="$1"; model="${2:-small}"; burn="${3:-ja}"; lang="${4:-de}"
srt="${in%.*}.srt"
python3 "$(dirname "$0")/_whisper_srt.py" "$in" "$srt" "$model" "$lang"
if [ "$burn" = "ja" ]; then
  out="${in%.*}_sub.mp4"
  style="FontName=Arial,FontSize=13,Bold=1,PrimaryColour=&H00FFFFFF,OutlineColour=&H00000000,BorderStyle=1,Outline=2,Alignment=2,MarginV=60"
  ffmpeg -v error -stats -y -i "$in" -vf "subtitles=$srt:force_style='$style'" -c:a copy "$out"
  echo "Fertig: $out"
fi
echo "SRT: $srt"
