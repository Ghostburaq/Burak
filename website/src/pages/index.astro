---
import BaseLayout from '../layouts/BaseLayout.astro';
import SineDivider from '../components/SineDivider.astro';
import { site } from '../lib/site';

const services = [
  { href: '/leistungen#pq-messung', title: 'PQ-Messkampagne', text: 'Sieben-Tage-Messung mit Klasse-A-Geraet, Auswertung nach EN 50160.' },
  { href: '/leistungen#stoerungsanalyse', title: 'Stoerungs- und Ursachenanalyse', text: 'Flicker, Oberschwingungen, Spannungseinbrueche, Resonanzen — nach dem Prinzip Differentialdiagnose.' },
  { href: '/leistungen#emv-beratung', title: 'EMV- und Installationsberatung', text: 'Vor der Beschaffung. Vor dem Umbau. Vor der Eskalation.' },
  { href: '/leistungen#gutachten', title: 'Gutachten und Beweissicherung', text: 'Rechtsfest dokumentierte Messungen als Grundlage fuer Klaerung und Entscheidung.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.brand,
  description: 'Unabhaengige Messungen und Beratung zu Netzqualitaet (Power Quality) und EMV. Firmensitz Deutschland, Einsatz schwerpunktmaessig Schweiz.',
  founder: { '@type': 'Person', name: site.owner },
  areaServed: ['CH', 'DE'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: site.address.country,
  },
  email: `mailto:${site.contact.email}`,
  telephone: site.contact.phone,
  url: `https://${site.domain}/`,
};
---

<BaseLayout
  title="Netzqualitaet und EMV — Messen bevor investiert wird"
  description="Unabhaengige PQ- und EMV-Messungen mit Klasse-A-Geraet nach IEC 61000-4-30, Bewertung nach EN 50160. Firmensitz Deutschland, Kundschaft Schweiz."
  path="/"
  jsonLd={jsonLd}
  current="/"
>
  <section class="relative">
    <div class="grid gap-10 md:grid-cols-[1.35fr_1fr] md:gap-14">
      <div>
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-accent">Power Quality &amp; EMV</p>
        <h1 class="text-3xl font-semibold leading-tight text-ink-900 md:text-5xl md:leading-[1.1]">
          {site.claim}
        </h1>
        <p class="mt-5 max-w-prose text-lg leading-relaxed text-ink-700">
          Unabhaengige Messungen, verstaendliche Berichte, klare Empfehlungen. Damit Entscheidungen ueber
          Filter, Kompensation, Netzausbau oder EMV-Massnahmen auf Messwerten stehen, nicht auf Vermutung.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/kontakt" class="inline-flex items-center rounded-md bg-ink-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-ink-800">
            Erstgespraech anfragen
          </a>
          <a href="/ablauf" class="inline-flex items-center rounded-md border border-ink-300 bg-white px-4 py-2.5 text-sm font-medium text-ink-800 transition hover:border-ink-500">
            So laeuft eine Messung ab
          </a>
        </div>
      </div>

      <aside class="rounded-lg border border-ink-200 bg-white p-6 shadow-sm">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-500">Grundlage</h2>
        <ul class="mt-3 space-y-3 text-sm leading-relaxed text-ink-700">
          <li>
            <strong class="text-ink-900">Messgeraet Klasse A.</strong>
            Camille Bauer Metrawatt PQMobile5000 &mdash; erfuellt die Anforderungen nach IEC 61000-4-30 Klasse A.
          </li>
          <li>
            <strong class="text-ink-900">Bezugsrahmen EN 50160.</strong>
            Bewertung der Spannungsmerkmale am Uebergabepunkt.
          </li>
          <li>
            <strong class="text-ink-900">Unabhaengig.</strong>
            Kein Geraeteverkauf, keine Provisionsbindung. Herstellerneutral.
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <SineDivider />

  <section class="mt-16">
    <h2 class="text-2xl font-semibold text-ink-900">Fuer wen</h2>
    <p class="mt-2 max-w-prose text-ink-700">
      Wer eine belastbare Aussage ueber sein Netz braucht, bekommt sie hier &mdash; ohne Verkaufsdruck.
    </p>
    <ul class="mt-6 grid gap-3 text-sm text-ink-800 sm:grid-cols-2 md:grid-cols-3">
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Industrie und produzierendes Gewerbe</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">KMU mit sensiblen Prozessen</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Immobilienverwaltungen</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Gemeinden und oeffentliche Betriebe</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Netzbetreiber und Elektroinstallateure</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Anwaelte und Sachverstaendige (Beweissicherung)</li>
    </ul>
  </section>

  <section class="mt-16">
    <div class="flex items-end justify-between gap-6">
      <div>
        <h2 class="text-2xl font-semibold text-ink-900">Leistungen im Ueberblick</h2>
        <p class="mt-2 max-w-prose text-ink-700">Vier Kernleistungen. Details und Anwendungsfaelle auf der Leistungsseite.</p>
      </div>
      <a href="/leistungen" class="hidden text-sm font-medium text-ink-700 underline decoration-ink-300 underline-offset-4 hover:decoration-ink-700 md:inline">Alle Leistungen</a>
    </div>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {services.map((s) => (
        <li>
          <a href={s.href} class="group block h-full rounded-lg border border-ink-200 bg-white p-6 transition hover:border-ink-400 hover:shadow-sm">
            <h3 class="text-lg font-semibold text-ink-900 group-hover:text-ink-950">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700">{s.text}</p>
            <span class="mt-4 inline-flex items-center text-sm text-accent">Mehr erfahren &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-16 rounded-lg border border-ink-200 bg-ink-900 p-8 text-white md:p-10">
    <div class="grid gap-6 md:grid-cols-[1.4fr_1fr] md:items-center">
      <div>
        <h2 class="text-2xl font-semibold">Erst messen, dann dimensionieren.</h2>
        <p class="mt-3 max-w-prose text-ink-200">
          Nennen Sie das Symptom &mdash; Flicker, ausgeloeste Schutzeinrichtungen, Prozessstoerungen, EMV-Verdacht.
          Ich schlage einen konkreten Messplan vor und gebe eine Einschaetzung, ob eine Messung ueberhaupt lohnt.
        </p>
      </div>
      <div class="flex gap-3 md:justify-end">
        <a href="/kontakt" class="inline-flex items-center rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-white transition hover:bg-amber-800">
          Erstgespraech anfragen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
