---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

const services = [
  { href: '/leistungen#pq-messung',   title: 'PQ-Messkampagne',            text: 'Siebentägige Messung mit Klasse-A-Gerät, Auswertung nach EN 50160.' },
  { href: '/leistungen#stoerungsanalyse', title: 'Störungs- und Ursachenanalyse', text: 'Flicker, Oberschwingungen, Spannungseinbrüche, Resonanzen nach dem Prinzip der Differentialdiagnose.' },
  { href: '/leistungen#emv-beratung', title: 'EMV- und Installationsberatung', text: 'Vor der Beschaffung. Vor dem Umbau. Vor der Eskalation.' },
  { href: '/leistungen#gutachten',    title: 'Gutachten und Beweissicherung', text: 'Rechtsfest dokumentierte Messungen als Grundlage für Klärung und Entscheidung.' },
];

const base = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.brand,
  description: 'Unabhängige Messungen und Beratung zu Netzqualität (Power Quality) und EMV in der Schweiz.',
  logo: new URL('/logo/logo-lockup.svg', base).toString(),
  image: new URL('/og-image.png', base).toString(),
  founder: { '@type': 'Person', name: site.owner },
  areaServed: 'CH',
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: 'CH',
  },
  email: `mailto:${site.contact.email}`,
  telephone: site.contact.phoneLink,
  url: base.toString(),
};
---

<BaseLayout
  title="Netzqualität und EMV messen, bevor investiert wird"
  description="Unabhängige PQ- und EMV-Messungen mit Klasse-A-Gerät nach IEC 61000-4-30, Bewertung nach EN 50160. Sitz Schweiz."
  path="/"
  jsonLd={jsonLd}
  current="/"
>
  <section>
    <div class="grid gap-10 md:grid-cols-[1.35fr_1fr] md:gap-14">
      <div>
        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-violett">Power Quality &amp; EMV</p>
        <h1 class="text-3xl font-semibold leading-tight text-anthrazit md:text-5xl md:leading-[1.1]">
          {site.claim}
        </h1>
        <p class="mt-5 max-w-prose text-lg leading-relaxed text-ink-700">
          Unabhängige Messungen, verständliche Berichte, klare Empfehlungen. Damit Entscheidungen über
          Filter, Kompensation, Netzausbau oder EMV-Massnahmen auf Messwerten stehen, nicht auf Vermutung.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/kontakt" class="inline-flex items-center rounded-md bg-violett px-4 py-2.5 text-sm font-medium text-white no-underline transition hover:bg-[#2611b8]">
            Erstgespräch anfragen
          </a>
          <a href="/ablauf" class="inline-flex items-center rounded-md border border-ink-300 bg-white px-4 py-2.5 text-sm font-medium text-anthrazit no-underline transition hover:border-anthrazit">
            So läuft eine Messung ab
          </a>
        </div>
      </div>

      <aside class="rounded-lg border border-ink-200 bg-white p-6 shadow-sm">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-500">Grundlage</h2>
        <ul class="mt-3 space-y-3 text-sm leading-relaxed text-ink-700">
          <li>
            <strong class="text-anthrazit">Messgerät Klasse A.</strong>
            Eingesetzt werden Messgeräte, welche die Genauigkeitsklasse A nach IEC 61000-4-30 erfüllen.
          </li>
          <li>
            <strong class="text-anthrazit">Bezugsrahmen EN 50160.</strong>
            Bewertung der Spannungsmerkmale am Übergabepunkt.
          </li>
          <li>
            <strong class="text-anthrazit">Unabhängig.</strong>
            Kein Geräteverkauf, keine Provisionsbindung. Herstellerneutral.
          </li>
        </ul>
      </aside>
    </div>
  </section>

  <div class="mt-14 flex items-center gap-6" aria-hidden="true">
    <span class="h-px flex-1 bg-gradient-to-r from-transparent to-ink-200"></span>
    <img src="/logo/mark.svg" alt="" width="52" height="55" decoding="async" style="width:52px;height:auto" />
    <span class="h-px flex-1 bg-gradient-to-l from-transparent to-ink-200"></span>
  </div>

  <section class="mt-16">
    <h2 class="text-2xl font-semibold text-anthrazit">Für wen</h2>
    <p class="mt-2 max-w-prose text-ink-700">
      Wer eine belastbare Aussage über sein Netz braucht, bekommt sie hier &mdash; ohne Verkaufsdruck.
    </p>
    <ul class="mt-6 grid gap-3 text-sm text-ink-800 sm:grid-cols-2 md:grid-cols-3">
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Industrie und produzierendes Gewerbe</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">KMU mit sensiblen Prozessen</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Immobilienverwaltungen</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Gemeinden und öffentliche Betriebe</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Netzbetreiber und Elektroinstallateure</li>
      <li class="rounded-md border border-ink-200 bg-white px-4 py-3">Anwälte und Sachverständige (Beweissicherung)</li>
    </ul>
  </section>

  <section class="mt-16">
    <h2 class="text-2xl font-semibold text-anthrazit">Woher die Einschätzung kommt</h2>
    <p class="mt-3 max-w-prose text-ink-700">
      Über fünfzehn Jahre Messpraxis in EMV und Netzqualität, von Kleinelektronik bis zu grossen Systemen.
      Eigene Messmittel der Genauigkeitsklasse A nach IEC 61000-4-30, alle zwei Jahre kalibriert.
      Berufshaftpflichtversicherung vorhanden. Lizenzierter Funkamateur.
      Kein Gerätehandel, keine Provisionsbindung.
    </p>
  </section>

  <section class="mt-16">
    <div class="flex items-end justify-between gap-6">
      <div>
        <h2 class="text-2xl font-semibold text-anthrazit">Leistungen im Überblick</h2>
        <p class="mt-2 max-w-prose text-ink-700">Vier Kernleistungen. Details auf der Leistungsseite.</p>
      </div>
      <a href="/leistungen" class="hidden text-sm font-medium text-violett underline decoration-ink-300 underline-offset-4 hover:decoration-violett md:inline">Alle Leistungen</a>
    </div>
    <ul class="mt-6 grid gap-4 md:grid-cols-2">
      {services.map((s) => (
        <li>
          <a href={s.href} class="group block h-full rounded-lg border border-ink-200 bg-white p-6 no-underline transition hover:border-anthrazit hover:shadow-sm">
            <h3 class="text-lg font-semibold text-anthrazit group-hover:text-violett">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-700">{s.text}</p>
            <span class="mt-4 inline-flex items-center text-sm text-violett">Mehr erfahren &rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-16 rounded-lg border border-ink-200 bg-anthrazit p-8 text-white md:p-10">
    <div class="grid gap-6 md:grid-cols-[1.4fr_1fr] md:items-center">
      <div>
        <h2 class="text-2xl font-semibold">Erst messen, dann dimensionieren.</h2>
        <p class="mt-3 max-w-prose text-ink-200">
          Nennen Sie das Symptom &mdash; Flicker, ausgelöste Schutzeinrichtungen, Prozessstörungen, EMV-Verdacht.
          Gemeinsam legen wir einen Messplan fest, und Sie erhalten eine Einschätzung, ob eine Messung
          überhaupt lohnt.
        </p>
      </div>
      <div class="flex gap-3 md:justify-end">
        <a href="/kontakt" class="inline-flex items-center rounded-md bg-violett px-4 py-2.5 text-sm font-medium text-white no-underline transition hover:bg-[#2611b8]">
          Erstgespräch anfragen
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
