---
import BaseLayout from '../layouts/BaseLayout.astro';
import SineDivider from '../components/SineDivider.astro';

const steps = [
  {
    n: '01',
    title: 'Erstgespraech und Symptomaufnahme',
    text: 'Kurzes Gespraech per Telefon oder Video. Was ist das Symptom, seit wann tritt es auf, was wurde bereits versucht. Ergebnis: Einschaetzung, ob eine Messung ueberhaupt lohnt.',
  },
  {
    n: '02',
    title: 'Messplan',
    text: 'Klaerung von Messort, Dauer, benoetigten Zugaengen, Sicherheitsanforderungen und dem Bezugsrahmen (z.B. EN 50160). Fixierung des Berichtsformats.',
  },
  {
    n: '03',
    title: 'Messung vor Ort',
    text: 'Aufbau und Inbetriebnahme des Messgeraets (Klasse A nach IEC 61000-4-30). Dokumentation von Ort, Anschlusspunkt und Konfiguration. Betrieb ueblicherweise sieben Tage.',
  },
  {
    n: '04',
    title: 'Auswertung und Normvergleich',
    text: 'Auswertung der Rohdaten. Perzentil-Betrachtung, Ereignis-Auszug, Vergleich gegen den vereinbarten Bezugsrahmen. Trennung von Befund und Interpretation.',
  },
  {
    n: '05',
    title: 'Bericht mit Befund und Empfehlung',
    text: 'Nachvollziehbarer Bericht in deutscher Sprache. Was wurde gemessen, wie wurde bewertet, was ist die begruendete Empfehlung. Kein Bericht ohne Klartext.',
  },
  {
    n: '06',
    title: 'Optional: Massnahmenbegleitung',
    text: 'Begleitung bei Auswahl, Auslegung und Wirksamkeitspruefung (z.B. Filter, Kompensation, EMV-Massnahmen) &mdash; herstellerneutral.',
  },
];
---

<BaseLayout
  title="Ablauf und Methodik"
  description="Wie eine PQ- oder EMV-Messung ablaeuft: Symptomaufnahme, Messplan, Messung mit Klasse-A-Geraet, Auswertung, Bericht, optional Massnahmenbegleitung."
  path="/ablauf"
  current="/ablauf"
>
  <header>
    <p class="text-xs font-semibold uppercase tracking-widest text-accent">Ablauf und Methodik</p>
    <h1 class="mt-2 text-3xl font-semibold leading-tight text-ink-900 md:text-4xl">
      Messen bevor dimensionieren.
    </h1>
    <p class="mt-4 max-w-prose text-ink-700">
      Ein einfaches Prinzip: erst Augenschein, dann Messung, dann Auslegung. In sechs Schritten von der ersten
      Symptomaufnahme bis zum belastbaren Bericht &mdash; nachvollziehbar, unabhaengig, dokumentiert.
    </p>
  </header>

  <SineDivider />

  <ol class="mt-10 space-y-4">
    {steps.map((s) => (
      <li class="rounded-lg border border-ink-200 bg-white p-6 md:p-7">
        <div class="flex items-start gap-5">
          <span class="mt-1 select-none font-mono text-sm text-accent">{s.n}</span>
          <div>
            <h2 class="text-lg font-semibold text-ink-900">{s.title}</h2>
            <p class="mt-2 max-w-prose text-sm leading-relaxed text-ink-700" set:html={s.text}></p>
          </div>
        </div>
      </li>
    ))}
  </ol>

  <section class="mt-12 grid gap-6 md:grid-cols-2">
    <div class="rounded-lg border border-ink-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-ink-900">Unabhaengigkeit</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-700">
        Kein Geraeteverkauf, keine Provisionsbindung, kein Erfolgshonorar an bestimmte Massnahmen. Empfehlungen
        richten sich nach dem Messergebnis, nicht nach dem Katalog.
      </p>
    </div>
    <div class="rounded-lg border border-ink-200 bg-white p-6">
      <h2 class="text-lg font-semibold text-ink-900">Nachvollziehbarkeit</h2>
      <p class="mt-2 text-sm leading-relaxed text-ink-700">
        Rohdaten, Geraetekonfiguration und Auswertelogik werden dokumentiert. Eine Zweitmeinung kann auf den
        gleichen Daten aufsetzen. Gemessen statt behauptet.
      </p>
    </div>
  </section>

  <div class="mt-10">
    <a href="/kontakt" class="inline-flex items-center rounded-md bg-ink-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-ink-800">
      Erstgespraech anfragen
    </a>
  </div>
</BaseLayout>
