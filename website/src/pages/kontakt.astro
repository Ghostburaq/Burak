---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';
---

<BaseLayout
  title="Kontakt"
  description="Erstgespraech anfragen. Kontaktformular, E-Mail und Telefon direkt sichtbar."
  path="/kontakt"
  current="/kontakt"
>
  <header>
    <p class="text-xs font-semibold uppercase tracking-widest text-violett">Kontakt</p>
    <h1 class="mt-2 text-3xl font-semibold leading-tight text-anthrazit md:text-4xl">
      Kurz beschreiben, was das Symptom ist &mdash; der Rest ergibt sich im Gespraech.
    </h1>
  </header>

  <div class="mt-10 grid gap-10 md:grid-cols-[1.4fr_1fr]">
    <section aria-labelledby="form-heading" class="rounded-lg border border-ink-200 bg-white p-6 md:p-8">
      <h2 id="form-heading" class="text-lg font-semibold text-anthrazit">Anfrage</h2>
      <p class="mt-2 text-sm text-ink-700">
        Pflichtfelder mit <span aria-hidden="true" class="text-violett">*</span> markiert. Rueckmeldung in der Regel innert
        zwei Werktagen.
      </p>

      <!--
        Netlify Forms: statisches HTML im Build, damit Netlify das Formular erkennt.
        - name="kontakt" wird im Netlify-Dashboard als Formulartitel gefuehrt
        - data-netlify="true" aktiviert die Verarbeitung
        - netlify-honeypot="bot-field" verweist auf das versteckte Feld
        - action="/danke" leitet nach erfolgreichem Absenden auf die Danke-Seite
        - form-name als verstecktes Feld ist Pflicht, sonst nimmt Netlify die Einsendung nicht an
        - bot-field: per CSS ausgeblendet, tabindex=-1 und autocomplete=off. Kein type="hidden".
      -->
      <form
        name="kontakt"
        method="POST"
        action="/danke"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-6 space-y-5"
      >
        <input type="hidden" name="form-name" value="kontakt" />

        <p class="sr-only" aria-hidden="true">
          <label>Bitte dieses Feld leer lassen:
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <div class="grid gap-5 md:grid-cols-2">
          <label class="block text-sm">
            <span class="mb-1 block font-medium text-anthrazit">Name <span aria-hidden="true" class="text-violett">*</span></span>
            <input required name="name" autocomplete="name" class="block w-full rounded-md border border-ink-300 bg-white px-3 py-2 text-sm text-anthrazit shadow-sm focus:border-violett" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-medium text-anthrazit">Firma</span>
            <input name="firma" autocomplete="organization" class="block w-full rounded-md border border-ink-300 bg-white px-3 py-2 text-sm text-anthrazit shadow-sm focus:border-violett" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-medium text-anthrazit">E-Mail <span aria-hidden="true" class="text-violett">*</span></span>
            <input required type="email" name="email" autocomplete="email" class="block w-full rounded-md border border-ink-300 bg-white px-3 py-2 text-sm text-anthrazit shadow-sm focus:border-violett" />
          </label>
          <label class="block text-sm">
            <span class="mb-1 block font-medium text-anthrazit">Telefon (optional)</span>
            <input type="tel" name="telefon" autocomplete="tel" class="block w-full rounded-md border border-ink-300 bg-white px-3 py-2 text-sm text-anthrazit shadow-sm focus:border-violett" />
          </label>
        </div>

        <label class="block text-sm">
          <span class="mb-1 block font-medium text-anthrazit">Nachricht <span aria-hidden="true" class="text-violett">*</span></span>
          <textarea required name="nachricht" rows="6" class="block w-full rounded-md border border-ink-300 bg-white px-3 py-2 text-sm text-anthrazit shadow-sm focus:border-violett" placeholder="Kurz: Symptom, Standort, seit wann, was bereits versucht wurde."></textarea>
        </label>

        <label class="flex items-start gap-3 text-sm text-ink-700">
          <input required type="checkbox" name="einwilligung" value="ja" class="mt-1 h-4 w-4 rounded border-ink-400 text-violett focus:ring-violett" />
          <span>
            Ich willige ein, dass meine Angaben zur Bearbeitung meiner Anfrage bearbeitet werden. Details in der
            <a href="/datenschutz" class="text-violett underline decoration-ink-300 underline-offset-4 hover:decoration-violett">Datenschutzerklaerung</a>.
            Die Einwilligung kann jederzeit widerrufen werden.
            <span aria-hidden="true" class="text-violett">*</span>
          </span>
        </label>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" class="inline-flex items-center rounded-md bg-violett px-4 py-2.5 text-sm font-medium text-white transition hover:bg-[#2611b8]">
            Anfrage senden
          </button>
          <span class="text-xs text-ink-500">Keine Newsletter. Keine Weitergabe an Dritte ausser den zur Bearbeitung noetigen Auftragsbearbeitern.</span>
        </div>
      </form>
    </section>

    <aside class="space-y-4">
      <div class="rounded-lg border border-ink-200 bg-white p-6">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-500">Direktkontakt</h2>
        <dl class="mt-3 space-y-3 text-sm text-ink-800">
          <div>
            <dt class="text-ink-500">E-Mail</dt>
            <dd><a class="text-violett underline decoration-ink-300 underline-offset-4 hover:decoration-violett" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
          </div>
          <div>
            <dt class="text-ink-500">Telefon</dt>
            <dd><a class="text-violett underline decoration-ink-300 underline-offset-4 hover:decoration-violett" href={`tel:${site.contact.phoneLink}`}>{site.contact.phoneDisplay}</a></dd>
          </div>
          <div>
            <dt class="text-ink-500">Anschrift</dt>
            <dd>
              {site.owner}<br />
              {site.brand}<br />
              {site.address.street}<br />
              {site.address.zip} {site.address.city}<br />
              {site.address.country}
            </dd>
          </div>
        </dl>
      </div>
      <div class="rounded-lg border border-ink-200 bg-anthrazit p-6 text-ink-100">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-ink-300">Antwortzeit</h2>
        <p class="mt-2 text-sm leading-relaxed">
          Antwort in der Regel innert zwei Werktagen. Bei akuten Prozessstoerungen kurz per Telefon melden.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
