---
interface Props { text?: string }
const { text = 'Entwurf. Vor Live-Gang durch Anwalt bzw. Treuhänder prüfen lassen.' } = Astro.props;
---
<div role="note" class="mb-8 rounded-md border border-magenta/40 bg-magenta/5 px-4 py-3 text-sm leading-relaxed text-magenta">
  <strong>Hinweis:</strong> {text}
</div>
