---
import { legalNav, nav, site } from '../lib/site';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-200 bg-white">
  <div class="mx-auto grid max-w-content gap-10 px-5 py-12 md:grid-cols-4 md:px-8">
    <div class="md:col-span-2">
      <div class="flex items-center gap-2 font-semibold text-ink-900">
        <svg width="22" height="22" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="10" fill="#0F172A" />
          <path d="M8 40 Q16 20 24 40 T40 40 T56 40" fill="none" stroke="#B45309" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span>{site.brand}</span>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-500">
        Unabhaengige Messungen und Beratung fuer Netzqualitaet und EMV. Firmensitz Deutschland, Einsatz schwerpunktmaessig Schweiz.
      </p>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-500">Navigation</h3>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        {nav.map((item) => (
          <li><a href={item.href} class="hover:text-ink-900">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-wider text-ink-500">Rechtliches</h3>
      <ul class="mt-3 space-y-2 text-sm text-ink-700">
        {legalNav.map((item) => (
          <li><a href={item.href} class="hover:text-ink-900">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-100">
    <div class="mx-auto flex max-w-content flex-col justify-between gap-2 px-5 py-5 text-xs text-ink-500 md:flex-row md:px-8">
      <span>&copy; {year} {site.brand}. Alle Rechte vorbehalten.</span>
      <span>Inhaber: {site.owner}</span>
    </div>
  </div>
</footer>
