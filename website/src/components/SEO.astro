---
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: unknown;
  noindex?: boolean;
}
const { title, description, path = '', jsonLd, noindex = false } = Astro.props;
const base = Astro.site ?? `https://${site.domain}`;
const canonical = new URL(path, base).toString();
const fullTitle = `${title} | ${site.brand}`;
// TODO: Für Social-Previews zusätzlich ein PNG (1200x630) erzeugen. Viele
// Plattformen rendern SVG als og:image nicht. Siehe OFFENE_PUNKTE.md.
const ogImage = new URL('/logo/logo-lockup.svg', base).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.brand} />
<meta property="og:locale" content="de_CH" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={`Logo ${site.brand}`} />
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{jsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
)}
