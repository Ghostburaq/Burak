---
import { nav, site } from '../lib/site';

interface Props { current?: string }
const { current = '' } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-ink-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-content items-center justify-between gap-6 px-5 py-3 md:px-8">
    <a href="/" class="flex items-center gap-3 font-semibold text-anthrazit" aria-label={`${site.brand} — Startseite`}>
      <img src="/logo/mark.svg" alt="" width="36" height="36" class="h-9 w-9" decoding="async" />
      <span class="hidden text-[0.98rem] tracking-tight sm:inline">{site.brand}</span>
    </a>

    <nav aria-label="Hauptnavigation" class="hidden md:block">
      <ul class="flex items-center gap-6 text-sm text-ink-700">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'no-underline transition hover:text-violett',
                current === item.href && 'text-anthrazit font-medium',
              ]}
              aria-current={current === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href="/kontakt"
      class="inline-flex items-center rounded-md bg-violett px-3.5 py-2 text-sm font-medium text-white no-underline transition hover:bg-[#2611b8]"
    >Erstgespraech anfragen</a>
  </div>

  <details class="border-t border-ink-100 md:hidden">
    <summary class="cursor-pointer list-none px-5 py-3 text-sm text-ink-700">Menue</summary>
    <ul class="space-y-1 px-5 pb-4 text-sm">
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block rounded px-2 py-2 no-underline hover:bg-ink-100',
              current === item.href && 'font-medium text-anthrazit',
            ]}
          >{item.label}</a>
        </li>
      ))}
    </ul>
  </details>
</header>
